# The gateway image installs the mesocosm package (mesocosm.gateway.app) with its gateway extra.
# Build context is the repository root (spike/docker/compose.yml sets it).
FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md /app/
COPY src /app/src
RUN pip install --no-cache-dir ".[gateway]"
ENV MESOCOSM_GATEWAY_HOST=0.0.0.0 MESOCOSM_GATEWAY_PORT=8080
EXPOSE 8080
CMD ["python", "-m", "mesocosm.gateway"]
