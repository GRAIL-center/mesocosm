{
  "$schema": "https://opencode.ai/config.json",
  "model": "internal/qwen3-4b",
  "small_model": "internal/qwen3-4b",
  "permission": "allow",
  "provider": {
    "internal": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Internal LLM API",
      "options": {
        "baseURL": "http://gateway:8080/v1",
        "apiKey": "mesocosm-local",
        "headers": {
          "X-Mesocosm-Agent": "agent-1",
          "X-Mesocosm-Run": "spike-docker"
        }
      },
      "models": {
        "qwen3-4b": {
          "name": "qwen3-4b",
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  }
}
