# World services: board, wiki, git, pypi, sites and the hidden pastebin channel in one container
# (mesocosm.env.services). Attached to every sandbox network under those hostnames; no egress.
# Build context is the repository root. The package index is filled at build time, when the
# network is available; at run time the agents install from it without reaching the internet.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md /app/
COPY src /app/src
RUN pip install --no-cache-dir ".[gateway]"
# Pure-python wheels for the agents' Python (Debian bookworm: 3.11). A package without such a wheel fails the build.
ARG PYPI_PACKAGES="requests pytest rich pyyaml"
RUN mkdir -p /data/pypi/files && pip download --no-cache-dir -d /data/pypi/files \
      --python-version 3.11 --only-binary=:all: --platform manylinux2014_x86_64 ${PYPI_PACKAGES}
COPY spike/world/wiki /data/wiki
ENV MESOCOSM_SERVICES_DATA=/data MESOCOSM_SERVICES_PORT=80
EXPOSE 80
HEALTHCHECK --interval=5s --timeout=3s --retries=10 CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:80/health')"
CMD ["python", "-m", "mesocosm.env.services"]
