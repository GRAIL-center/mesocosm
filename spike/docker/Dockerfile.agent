# Experimental-agent container: OpenCode server + a workspace. Attached only to the
# internal sandbox network at runtime (compose.yml). Build-time network access is fine.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates python3 python3-venv jq iputils-ping \
 && rm -rf /var/lib/apt/lists/*

# Pin after the spike settles on a version.
ARG OPENCODE_VERSION=latest
RUN npm install -g "opencode-ai@${OPENCODE_VERSION}"

COPY docker/agent-entrypoint.sh /usr/local/bin/agent-entrypoint
COPY 07_egress_check.sh /usr/local/bin/egress-check
RUN chmod +x /usr/local/bin/agent-entrypoint /usr/local/bin/egress-check

WORKDIR /work
EXPOSE 4096
ENTRYPOINT ["agent-entrypoint"]
