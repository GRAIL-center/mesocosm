# Experimental-agent container: OpenCode server + a workspace. Attached only to the
# internal sandbox network at runtime (compose.yml). Build-time network access is fine.
# Nothing in the image names the platform (ADR-0019): the harness config and the git identity are
# files the control plane mounts; the egress check is piped in at run time.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates python3 python3-venv python3-pip jq iputils-ping \
 && rm -rf /var/lib/apt/lists/*

# The version the Colab spike validated (issue #3).
ARG OPENCODE_VERSION=1.19.3
RUN npm install -g "opencode-ai@${OPENCODE_VERSION}"

# The package index inside the sandbox (mesocosm.env.services); pip never sees the internet.
ENV PIP_INDEX_URL=http://pypi/simple PIP_TRUSTED_HOST=pypi PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_BREAK_SYSTEM_PACKAGES=1
WORKDIR /work
EXPOSE 4096
ENTRYPOINT ["opencode", "serve", "--hostname", "0.0.0.0", "--port", "4096"]
